generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Transaction {
  id                 Int              @id @default(autoincrement())
  date               DateTime         @default(now())
  amount             Float
  description        String
  category           String
  person             String
  type               String
  source             String           @default("web")
  context            String           @default("casa")
  recurringExpenseId Int?
  recurringExpense   RecurringExpense? @relation(fields: [recurringExpenseId], references: [id])
  clientCosts        ClientCost[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([date])
  @@index([person])
  @@index([type])
  @@index([category])
}

model RecurringExpense {
  id           Int           @id @default(autoincrement())
  description  String
  amount       Float
  category     String
  person       String
  dayOfMonth   Int
  active       Boolean       @default(true)
  context      String        @default("casa")
  transactions Transaction[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model Client {
  id           Int             @id @default(autoincrement())
  name         String
  contractType String          // 'monthly' | 'installments'
  status       String          @default("active") // 'active' | 'paused' | 'completed'
  notes        String?
  payments     ClientPayment[]
  costs        ClientCost[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model ClientCost {
  id             Int          @id @default(autoincrement())
  clientId       Int
  client         Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description    String
  amount         Float
  category       String       @default("Outros")
  date           DateTime     @default(now())
  referenceMonth String       @default("")
  transactionId  Int?         // Transaction gerada automaticamente no dashboard
  transaction    Transaction? @relation(fields: [transactionId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([clientId])
}

model ClientPayment {
  id             Int      @id @default(autoincrement())
  clientId       Int
  client         Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  description    String
  amount         Float
  dueDate        DateTime
  paid           Boolean  @default(false)
  paidAt         DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([dueDate])
  @@index([paid])
}
