generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Transaction {
  id          Int      @id @default(autoincrement())
  date        DateTime @default(now())
  amount      Float
  description String
  category    String
  person      String   // "JOTAPE" ou "Carol"
  type        String   // "gasto" ou "receita"
  source      String   @default("web") // "web" ou "telegram"
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date])
  @@index([person])
  @@index([type])
  @@index([category])
}
