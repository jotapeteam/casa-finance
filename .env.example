# ====================================================
# Casa Finance — Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ====================================================

# --- Telegram Bot ---
# Obtenha o token no Telegram com @BotFather
TELEGRAM_BOT_TOKEN=seu_token_aqui

# IDs numéricos dos usuários autorizados (separados por vírgula)
# Use @userinfobot no Telegram para descobrir seu ID
TELEGRAM_AUTHORIZED_USER_IDS=123456789,987654321

# Nome de cada ID (mesma ordem dos IDs acima, separados por vírgula)
TELEGRAM_AUTHORIZED_USER_NAMES=JOTAPE,Carol

# --- OpenAI (transcrição de áudios com Whisper) ---
# https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...

# --- Anthropic (classificação automática de categorias) ---
# https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# --- Banco de Dados ---
# Para SQLite local, não altere
DATABASE_URL=file:./dev.db

# --- Servidor ---
PORT=3001
